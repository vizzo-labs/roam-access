{
  "name": "roam-access-pilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/maplibre/",
    "dev": "next dev",
    "prebuild": "npm run check:keys && npm run db:migrate && mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/maplibre/",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "dotenv -e .env.local -- tsx scripts/migrate.ts",
    "db:status": "dotenv -e .env.local -- tsx scripts/migrate.ts --status",
    "db:describe": "dotenv -e .env.local -- tsx scripts/db-describe.ts",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed-osm.ts",
    "layers:import": "dotenv -e .env.local -- tsx scripts/import-toilets.ts",
    "arrival:import": "dotenv -e .env.local -- tsx scripts/import-arrival.ts",
    "test-user": "dotenv -e .env.local -- tsx scripts/test-user.ts",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "check:keys": "tsx scripts/check-jsx-keys.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.24",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "ai": "^7.0.163",
    "drizzle-orm": "^0.45.4",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
